{
  "name": "dsh-llm-account",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness LLM provider plugin hosting the commandcode and dsh-opencode-go routes behind a shared account core",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./commandcode": {
      "types": "./lib/commandcode.d.ts",
      "default": "./lib/commandcode.js"
    },
    "./opencode": {
      "types": "./lib/opencode.d.ts",
      "default": "./lib/opencode.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
