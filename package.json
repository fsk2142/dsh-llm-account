{
  "name": "dsh-llm-account",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness LLM provider plugin hosting the commandcode, dsh-opencode-go and opendesign routes behind a shared account core",
  "license": "MIT",
  "author": "fsk2142",
  "homepage": "https://github.com/fsk2142/dsh-llm-account#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fsk2142/dsh-llm-account.git"
  },
  "bugs": {
    "url": "https://github.com/fsk2142/dsh-llm-account/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "llm",
    "provider",
    "commandcode",
    "opencode",
    "opendesign"
  ],
  "icon": "./icon.svg",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./commandcode": {
      "types": "./lib/commandcode.d.ts",
      "default": "./lib/commandcode.js"
    },
    "./opencode": {
      "types": "./lib/opencode.d.ts",
      "default": "./lib/opencode.js"
    },
    "./opendesign": {
      "types": "./lib/opendesign.d.ts",
      "default": "./lib/opendesign.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "version:next": "node scripts/next-version.mjs",
    "release": "node scripts/release.mjs",
    "dead-code": "node scripts/find-dead-code.mjs .",
    "fix:desktop-cookies": "node scripts/clear-desktop-auth-cookies.mjs",
    "check:newline": "node scripts/check-final-newline.mjs"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4 || ~4.0.5",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-alpha.1 || 0.2.1-alpha.2 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4 || ~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^26.6.5",
    "opencode-go-pi-ai": "npm:@earendil-works/pi-ai@1.1.0",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
